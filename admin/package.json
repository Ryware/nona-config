{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:openapi": "bash ../verify-generated-clients.sh --admin-path . --skip-tool-restore",
    "analyze": "ANALYZE=true npm run build",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.26.2",
    "@kobalte/core": "2.0.0-alpha.4",
    "@solid-primitives/clipboard": "^2.0.0",
    "@solid-primitives/cookies": "^2.0.0",
    "@solid-primitives/event-listener": "^3.0.0",
    "@solid-primitives/keyboard": "^2.0.0",
    "@solid-primitives/media": "^4.0.0",
    "@solid-primitives/storage": "^5.0.0",
    "@solid-primitives/timer": "^1.4.5",
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.3",
    "@tanstack/solid-query": "6.0.0-rc.6",
    "@tanstack/solid-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flatpickr": "^4.6.13",
    "openapi-fetch": "^0.13.0",
    "solid-icons": "^2.0.0",
    "solid-js": "^2.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.3",
    "@xeonlink/prettier-plugin-organize-attributes": "^1.1.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-solid": "^0.20.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "happy-dom": "^20.8.9",
    "msw": "^2.13.2",
    "openapi-typescript": "^7.0.0",
    "postcss": "^8.5.19",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.3"
  }
}
